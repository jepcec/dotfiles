{
  "layer": "top",
  "position": "top",
  "height": 20,
  "spacing": 0,
  "exclusive": true,
  "passthrough": false,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": [
    "network",
    "custom/sep",
    "cpu",
    "custom/sep",
    "memory",
    "custom/sep",
    "pulseaudio",
    "custom/sep",
    "clock",
    "custom/sep",
    "battery"
  ],

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{id}",
    "all-outputs": true,
    "disable-scroll": false,
    "active-only": false
  },

  "custom/sep": {
    "format": "|",
    "tooltip": false
  },

  "cpu": {
    "format": "cpu {usage}%",
    "tooltip": false,
    "interval": 2
  },

  "memory": {
    "format": "mem {used:0.1f}G",
    "tooltip": false,
    "interval": 5
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{calendar}",
    "calendar": {
  "mode": "month",
  "mode-mon-col": 1,
  "on-scroll": 1,
  "format": {
    "months": "<span color='#666666'>{}</span>",
    "days": "<span color='#666666'>{}</span>",
    "weekdays": "<span color='#666666'>{}</span>",
    "today": "<span color='#ffffff'><b>{}</b></span>"
  }
}
    }
  },

  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "eth",
    "format-disconnected": "off",
    "tooltip": false,
    "max-length": 20
  },

  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "muted",
    "tooltip": false,
    "on-click": "pavucontrol"
  },

  "battery": {
    "format": "{capacity}%",
    "tooltip": false,
    "interval": 30
  }
}
